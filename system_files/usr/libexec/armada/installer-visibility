#!/bin/bash
set -euo pipefail

if [[ -e /usr/lib/armada/tb321fu-hwtest ]]; then
    rm -f /run/armada/installable
    exit 0
fi

eval "$(/usr/libexec/armada/device-env)"
source /usr/lib/armada/storage-lib

# Hide the TryExec marker on internal boot; fail open so the installer surfaces detection errors.
armada_running_from_internal && exit 0
install -m 0755 /dev/null /run/armada/installable
